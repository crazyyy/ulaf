#, php-format
msgid ""
"Conflicting SMTP plugins detected: %s. This may cause email delivery issues."
msgstr ""
"Konflikt mit SMTP-Plugins erkannt: %s. Dies könnte zu Problemen beim E-Mail-"
"Versand führen."

#: includes/class-conflict-detector.php:483
msgid "No conflicting SMTP plugins detected."
msgstr "Keine konfliktierenden SMTP-Plugins erkannt."

#: includes/class-conflict-detector.php:484
msgid "Deactivate conflicting plugins to ensure reliable email delivery."
msgstr ""
"Deaktivieren Sie konflikt ierende Plugins, um einen zuverlässigen E-Mail-"
"Versand sicherzustellen."

#: includes/class-conflict-detector.php:587
#, php-format
msgid "Deactivate %s"
msgstr "%s deaktivieren"

