msgid ""
"Temp directory is not writable. Email attachments may not work properly."
msgstr ""
"El directorio temporal no es escribible. Los archivos adjuntos de correo "
"pueden no funcionar correctamente."

#: includes/class-conflict-detector.php:459
msgid "Ensure the temp directory has write permissions."
msgstr "Asegúrese de que el directorio temporal tenga permisos de escritura."

