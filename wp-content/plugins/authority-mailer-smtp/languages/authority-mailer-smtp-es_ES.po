#: includes/class-conflict-detector.php:323
msgid "WP-Cron"
msgstr "WP-Cron"

#: includes/class-conflict-detector.php:325
#: includes/class-conflict-detector.php:345
msgid "Disabled"
msgstr "Deshabilitado"

#: includes/class-conflict-detector.php:325
msgid "Enabled"
msgstr "Habilitado"

#: includes/class-conflict-detector.php:326
msgid "Enabled (recommended)"
msgstr "Habilitado (recomendado)"

#: includes/class-conflict-detector.php:328
msgid ""
"WP-Cron is disabled. Email queue processing and scheduled tasks may not work "
"properly unless you have a real cron job configured."
msgstr ""
"WP-Cron está deshabilitado. El procesamiento de la cola de correos y las "
"tareas programadas pueden no funcionar correctamente a menos que tenga "
"configurado un trabajo cron real."

#: includes/class-conflict-detector.php:329
msgid "WP-Cron is enabled and working."
msgstr "WP-Cron está habilitado y funcionando."

#: includes/class-conflict-detector.php:330
msgid "Set up a real cron job or enable WP-Cron in wp-config.php"
msgstr "Configure un trabajo cron real o habilite WP-Cron en wp-config.php"

#: includes/class-conflict-detector.php:343
msgid "PHP mail() Function"
msgstr "Función mail() de PHP"

#: includes/class-conflict-detector.php:345
msgid "Available"
msgstr "Disponible"

#: includes/class-conflict-detector.php:346
msgid "Available (for fallback)"
msgstr "Disponible (para respaldo)"

#: includes/class-conflict-detector.php:348
msgid ""
"PHP mail() is disabled. This is fine if using SMTP, but there is no fallback "
"option."
msgstr ""
"La función mail() de PHP está deshabilitada. Esto está bien si usa SMTP, "
"pero no hay opción de respaldo."

#: includes/class-conflict-detector.php:349
msgid "PHP mail() is available as a fallback option."
msgstr "La función mail() de PHP está disponible como opción de respaldo."

#: includes/class-conflict-detector.php:357
msgid "OpenSSL Extension"
msgstr "Extensión OpenSSL"

#: includes/class-conflict-detector.php:359
#: includes/class-conflict-detector.php:374
#: includes/class-conflict-detector.php:388
msgid "Not loaded"
msgstr "No cargado"

