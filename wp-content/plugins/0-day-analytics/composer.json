{
    "name": "advanced/analytics",
    "description": "Make WP 0-day analytics easier",
    "type": "wordpress-plugin",
    "version": "3.7.2",
    "authors": [
      {
        "name": "advanced-analytics",
        "email": "sdobreff@gmail.com"
      }
    ],
    "require": {
      "php": ">=7.4"
    },
    "autoload": {
      "psr-4": {
        "ADVAN\\": "classes/"
      },
      "classmap": [
        "classes/"
      ]
    },
    "require-dev": {
      "phpunit/phpunit": "^8.0"
    },
    "scripts": {
      "vendor-install": "sh bin/install-dependencies.sh",
      "lint": "phpcs .",
      "lint-fix": "phpcbf .",
      "wp-install": "wp-install --full --env-file .env --wp-composer-file composer.wp-install.json",
      "wpunit": "codecept run wpunit",
      "test": [
        "@wpunit"
      ]
    }
  }
  