<?xml version="1.0"?>
<ruleset name="DiveWP">
    <description>Custom ruleset for DiveWP plugin</description>

    <!-- Include WordPress ruleset -->
    <rule ref="WordPress" />

    <!-- Configure the text-domain -->
    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="divewp"/>
            </property>
        </properties>
    </rule>
</ruleset> 